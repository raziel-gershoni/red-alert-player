[Unit]
Description=Weekly yt-dlp update for red-alert music

[Timer]
# Weekly, Sunday 04:00 local (quiet hours). Persistent catches missed runs
# if the Pi was powered off; the random delay avoids a thundering herd.
OnCalendar=Sun *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
